# AgeCare — variables de entorno (plantilla)
# Copia este archivo como .env y reemplaza los valores.
# El .env NUNCA se sube al repositorio (está en .gitignore).

# ── Base de datos (PostgreSQL) ──
POSTGRES_USER=agecare
POSTGRES_PASSWORD=cambiar_por_clave_local
POSTGRES_DB=agecare

# ── Zona horaria de la operación ──
# Decide a qué DÍA pertenece cada instante guardado: "las dosis de hoy",
# "las tareas completadas hoy", en qué día cae un turno. Si no se pone,
# los días se calculan en UTC y desde las 21:00 en Chile ya es mañana.
TIMEZONE=America/Santiago

# ── Seguridad / JWT ──
# En producción, usar un secreto largo y aleatorio (p. ej. `openssl rand -hex 32`).
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# ── pgAdmin (opcional, solo desarrollo) ──
PGADMIN_EMAIL=tu_correo@ejemplo.cl
PGADMIN_PASSWORD=cambiar_por_clave_local

# ── Almacenamiento de archivos ──
# local = disco del contenedor (volumen 'archivos'); azure = Blob Storage.
STORAGE_BACKEND=local
# La URL con la que el teléfono alcanza la API. Es la que se arma en los
# enlaces temporales de subida y descarga, así que localhost NO sirve si la
# app corre en un celular: usa la IP de tu máquina o la del túnel.
STORAGE_PUBLIC_BASE_URL=http://localhost:8000
# Solo si STORAGE_BACKEND=azure.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=agecare

# ── Asistente de IA ──
# none         = el asistente responde 503 y la app lo muestra como no disponible.
# azure_openai = modelo de Azure. Las credenciales las entrega Alloxentric.
# openai_compatible = cualquier API compatible con OpenAI: Claude (Anthropic),
#                     NVIDIA, Groq, OpenRouter... Solo cambian estas variables.
ASSISTANT_PROVIDER=none
# Solo azure_openai usa ASSISTANT_ENDPOINT.
ASSISTANT_ENDPOINT=
# API key del proveedor (Anthropic: la de console.anthropic.com).
ASSISTANT_API_KEY=
# Id del modelo. Ejemplo Claude: claude-haiku-5-5.
ASSISTANT_MODEL=gpt-4o-mini
# Base URL compatible con OpenAI. Claude: https://api.anthropic.com/v1/
ASSISTANT_BASE_URL=
# false si el modelo rechaza temperature/top_p (Claude Haiku 5.5 lo hace).
ASSISTANT_SEND_SAMPLING=true

# ── Voz (transcripción y lectura en voz alta) ──
# none = /stt y /tts responden 503. azure = Azure AI Speech.
SPEECH_PROVIDER=none
SPEECH_REGION=
SPEECH_API_KEY=

# ── OCR de documentos del expediente ──
# none | tesseract (local) | nvidia_parse (Nemotron 3.5 Parse: la imagen,
# ya regenerada, sale a NVIDIA). Sin OCR_API_KEY usa ASSISTANT_API_KEY.
OCR_PROVIDER=tesseract
OCR_API_KEY=
