# AgeCare — variables de entorno (plantilla)
# Copia este archivo como .env y reemplaza los valores.
# El .env NUNCA se sube al repositorio (está en .gitignore).

# ── Base de datos (PostgreSQL) ──
POSTGRES_USER=agecare
POSTGRES_PASSWORD=cambiar_por_clave_local
POSTGRES_DB=agecare

# ── Seguridad / JWT ──
# En producción, usar un secreto largo y aleatorio (p. ej. `openssl rand -hex 32`).
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# ── pgAdmin (opcional, solo desarrollo) ──
PGADMIN_EMAIL=tu_correo@ejemplo.cl
PGADMIN_PASSWORD=cambiar_por_clave_local
