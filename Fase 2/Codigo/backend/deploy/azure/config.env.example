# Configuracion del despliegue en Azure (plantilla).
# Copia como config.env y ajusta. config.env NO se versiona.
#
#   cp config.env.example config.env

# Grupo de recursos: una carpeta logica. Borrarlo borra todo lo de adentro.
RG=agecare-rg

# Region. Si Azure for Students rechaza una, prueba otra
# (eastus2, brazilsouth, centralus, westus3).
LOCATION=brazilsouth

VM_NAME=agecare-vm

# B2s = 2 vCPU y 4 GB. Margen para 5 contenedores y el OCR (tesseract).
# Si el SKU no esta disponible en tu region, prueba Standard_B2ls_v2
# o Standard_B2as_v2.
VM_SIZE=Standard_B2s

ADMIN_USER=azureuser

# TU IP publica, solo para abrir SSH (puerto 22) a ti y a nadie mas.
# Averiguala en el navegador (busca "cual es mi ip"). Si tu ISP la cambia,
# SSH deja de responder: actualiza la regla con deploy/azure/ssh-ip.sh.
# Si la dejas vacia, crear-vm.sh se detiene.
MI_IP=
