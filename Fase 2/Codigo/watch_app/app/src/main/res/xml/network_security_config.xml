<?xml version="1.0" encoding="utf-8"?>
<!--
  Producción: el reloj llega al backend por HTTPS a través del subdominio
  público de Cloudflare Tunnel (https://agecare-api.javiercerna.dev).
  No se permite tráfico en texto plano (cleartext/HTTP): toda la comunicación
  va cifrada. Si en algún momento necesitas apuntar a un backend local por
  HTTP (p. ej. 192.168.x.x:8000 para pruebas sin túnel), agrega aquí un
  <domain-config cleartextTrafficPermitted="true"> con esa IP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
