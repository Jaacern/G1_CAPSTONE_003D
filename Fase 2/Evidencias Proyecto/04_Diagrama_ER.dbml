// ============================================================================
// AgeCare — Diagrama Entidad-Relación (modelo de datos definitivo)
// Proyecto APT · Capstone PTY4614 · DUOC UC
// ----------------------------------------------------------------------------
// Cómo usarlo:
//   1. Entra a https://dbdiagram.io
//   2. Pega este contenido en el editor
//   3. Exporta el diagrama como PNG o PDF (menú Export)
// ----------------------------------------------------------------------------
// 20 tablas · PostgreSQL · Normalizado hasta 2FN
// ============================================================================

Project AgeCare {
  database_type: 'PostgreSQL'
  Note: 'Modelo de datos del núcleo de salud. Control de acceso centralizado en patient_members.'
}

// ─────────────────────────── Bloque 1: Identidad y acceso ───────────────────

Table users {
  id uuid [pk]
  email varchar(254) [not null, unique]
  password_hash varchar(255) [not null]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  full_name varchar(121) [note: 'GENERATED (first_name + last_name)']
  phone varchar(16)
  avatar_url text
  locale varchar(5) [not null, default: 'es']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'Cuentas de usuario. El rol NO vive aquí: depende del paciente (patient_members).'
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  family_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoked_reason varchar(20)
  created_at timestamptz [not null]
  Note: 'Sesiones activas. Hash del refresh token, rotatorio y revocable.'
}

Table push_devices {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  push_token varchar(255) [not null, unique]
  platform varchar(10) [not null]
  is_active boolean [not null, default: true]
  last_seen_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Dispositivos para notificaciones push.'
}

Table patients {
  id uuid [pk]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  full_name varchar(121) [note: 'GENERATED']
  rut_number integer
  rut_dv char(1)
  birth_date date [not null]
  sex char(1) [not null]
  photo_url text
  timezone varchar(50) [not null, default: 'America/Santiago']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'Adultos mayores con expediente. No son usuarios.'
}

Table patient_conditions {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  condition varchar(80) [not null]
  diagnosed_at date
  created_at timestamptz [not null]
  Note: 'Condiciones médicas (1FN: reemplaza arreglo JSON).'

  indexes {
    (patient_id, condition) [unique]
  }
}

Table patient_members {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  user_id uuid [not null, ref: > users.id]
  role varchar(10) [not null, note: 'family | caregiver | doctor | elder']
  is_owner boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  removed_at timestamptz
  Note: 'Vínculo usuario↔paciente con rol. Centro del control de acceso.'

  indexes {
    (patient_id, user_id) [unique]
  }
}

Table invitations {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  email varchar(320) [not null]
  role varchar(10) [not null]
  token_hash varchar(64) [not null, unique]
  invited_by uuid [not null, ref: > users.id]
  expires_at timestamptz [not null]
  accepted_at timestamptz
  accepted_by uuid [ref: > users.id]
  revoked_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Invitaciones por correo. Token de un solo uso con vencimiento.'
}

Table audit_log {
  id uuid [pk]
  actor_user_id uuid [ref: > users.id]
  action varchar(40) [not null, note: 'view_record|create|update|dose_log|alert_ack|...']
  entity_type varchar(40) [not null]
  entity_id uuid
  patient_id uuid [ref: > patients.id]
  old_value jsonb
  new_value jsonb
  ip_address inet
  user_agent varchar(300)
  created_at timestamptz [not null]
  Note: 'Registro inmutable (append-only) de accesos y cambios clínicos. RNF-14. Trigger bloquea UPDATE/DELETE.'
}

Table system_parameters {
  key varchar(60) [pk]
  value varchar(120) [not null]
  value_type varchar(20) [not null, note: 'int|minutes|hours|decimal|bool|text']
  description varchar(300) [not null]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null]
  Note: 'Parámetros de negocio configurables (umbrales de alertas, vigencias). Saca valores del código.'
}

// ─────────────────────────── Bloque 2: Vitals y wearable ────────────────────

Table vital_types {
  code varchar(16) [pk]
  label varchar(60) [not null]
  unit varchar(10) [not null, default: '']
  has_secondary boolean [not null, default: false]
  Note: 'Catálogo de tipos de signos vitales. Fuente única de verdad.'
}

Table wearables {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  provider varchar(20) [not null, default: 'simulator']
  serial_number varchar(64) [not null]
  model varchar(60)
  battery_pct smallint
  last_sync_at timestamptz
  unlinked_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Dispositivo vestible. Un activo por paciente.'
}

Table vital_readings {
  id uuid
  patient_id uuid [not null, ref: > patients.id]
  type varchar(16) [not null, ref: > vital_types.code]
  value "numeric(8,2)" [not null]
  value_secondary "numeric(8,2)"
  measured_at timestamptz [not null]
  source varchar(10) [not null, note: 'wearable | manual']
  meta jsonb
  created_at timestamptz [not null]
  Note: 'Mediciones. PK compuesta (id, measured_at) por particionado mensual.'

  indexes {
    (id, measured_at) [pk]
    (patient_id, type, measured_at, source) [unique]
  }
}

Table vital_thresholds {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  type varchar(16) [not null, ref: > vital_types.code]
  min_value "numeric(8,2)"
  max_value "numeric(8,2)"
  updated_by uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Rango normal por paciente y tipo.'

  indexes {
    (patient_id, type) [unique]
  }
}

Table wellbeing_snapshots {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  snapshot_date date [not null]
  status varchar(12) [not null, note: 'ok|warning|attention']
  reasons jsonb [not null]
  vitals_out_of_range smallint [not null]
  doses_missed smallint [not null]
  active_alerts smallint [not null]
  computed_at timestamptz [not null]
  Note: 'Fotografía diaria del semáforo de bienestar. Historiza un indicador que antes se calculaba al vuelo.'

  indexes {
    (patient_id, snapshot_date) [unique]
  }
}

// ─────────────────────────── Bloque 3: Medicación ───────────────────────────

Table medications {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  name varchar(120) [not null]
  dose_amount "numeric(8,2)" [not null]
  dose_unit varchar(20) [not null, note: 'mg|g|ml|mcg|UI|gotas|...']
  dose_text varchar(60) [note: 'GENERATED (amount + unit)']
  instructions text
  start_date date [not null]
  end_date date
  grace_window_min smallint [not null, default: 60]
  prescribed_by uuid [ref: > users.id]
  discontinued_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Plan de medicamento: qué y con qué frecuencia. Dosis estructurada (cantidad + unidad).'
}

Table medication_times {
  id uuid [pk]
  medication_id uuid [not null, ref: > medications.id]
  time_of_day time [not null]
  Note: 'Horarios de toma (1FN).'

  indexes {
    (medication_id, time_of_day) [unique]
  }
}

Table medication_days {
  medication_id uuid [not null, ref: > medications.id]
  day_of_week smallint [not null, note: '1=lun … 7=dom']
  Note: 'Días habilitados (1FN). PK compuesta.'

  indexes {
    (medication_id, day_of_week) [pk]
  }
}

Table scheduled_doses {
  id uuid [pk]
  medication_id uuid [not null, ref: > medications.id]
  scheduled_at timestamptz [not null, note: 'cuándo DEBÍA darse']
  status varchar(10) [not null, default: 'pending', note: 'pending|taken|skipped|postponed|missed']
  administered_at timestamptz [note: 'cuándo se dio REALMENTE (hecho clínico)']
  logged_by uuid [ref: > users.id]
  logged_at timestamptz [note: 'cuándo se REGISTRÓ (acto administrativo)']
  reason varchar(200)
  postponed_until timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Tomas concretas. Sin patient_id (2FN). 3 momentos distintos: scheduled/administered/logged.'

  indexes {
    (medication_id, scheduled_at) [unique]
  }
}

// ─────────────────────────── Bloque 4: Alertas y emergencias ────────────────

Table alerts {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  type varchar(20) [not null, note: 'fall|vital_out_of_range|missed_dose|sos|wearable_offline']
  severity varchar(10) [not null, note: 'info|warning|critical']
  title varchar(120) [not null]
  detail text
  payload jsonb
  dedup_key varchar(60)
  status varchar(12) [not null, default: 'active', note: 'active|acknowledged|resolved']
  acknowledged_by uuid [ref: > users.id]
  acknowledged_at timestamptz
  resolved_by uuid [ref: > users.id]
  resolved_at timestamptz
  resolution_note varchar(500)
  escalated_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Alertas del sistema. Pilar central del producto.'
}

Table alert_deliveries {
  id uuid [pk]
  alert_id uuid [not null, ref: > alerts.id]
  user_id uuid [not null, ref: > users.id]
  push_device_id uuid [ref: > push_devices.id]
  channel varchar(10) [not null, default: 'push']
  status varchar(10) [not null, default: 'queued']
  sent_at timestamptz
  delivered_at timestamptz
  opened_at timestamptz
  error_detail varchar(300)
  created_at timestamptz [not null]
  Note: 'Un registro por intento de notificación. Mide latencias (RNF-05).'
}

Table notification_settings {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  alert_type varchar(20) [not null]
  push_enabled boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Preferencias por tipo. Caída y SOS no desactivables.'

  indexes {
    (user_id, alert_type) [unique]
  }
}

Table emergency_contacts {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  full_name varchar(121) [note: 'GENERATED']
  relationship varchar(40)
  phone varchar(16) [not null]
  escalation_order smallint [not null, default: 1]
  notes varchar(200)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'Contactos de emergencia en orden de escalamiento.'
}

Table sos_events {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  triggered_by uuid [ref: > users.id]
  alert_id uuid [not null, unique, ref: - alerts.id]
  note varchar(300)
  latitude "numeric(9,6)"
  longitude "numeric(9,6)"
  created_at timestamptz [not null]
  Note: 'Activaciones del botón de emergencia. Una por alerta.'
}

// ─────────────────────────── Bloque 5: Negocio (freemium) ───────────────────

Table subscriptions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  plan varchar(20) [not null, note: 'free|premium']
  status varchar(20) [not null, default: 'active', note: 'active|past_due|cancelled|expired']
  started_at timestamptz [not null]
  current_period_end timestamptz
  cancelled_at timestamptz
  provider_ref varchar(120) [note: 'referencia opaca a pasarela, sin datos de tarjeta']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Suscripciones freemium (RF-73). Soporta validación de acceso premium y métrica de conversión.'
}
